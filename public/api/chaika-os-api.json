    "code": "// Получаем токен из URL при открытии в ОС\nconst token = new URLSearchParams(window.location.search).get('token');\n\n// Инициализация Чайка SDK\nconst sdk = new ChaikaOS({ token });\n\n// Получить профиль пользователя\nconst profile = await sdk.user.getProfile();\nconsole.log('Пользователь:', profile.username);\n\n// Отправить уведомление в ОС\nawait sdk.notifications.send({\n  title: 'Привет, Чайка!',\n  body: `Добро пожаловать, ${profile.username}!`\n});\n\n// Открыть мессенджер и написать сообщение\nwindow.dispatchEvent(new CustomEvent('chaika-open-app', {\n  detail: { appId: 'messenger', shareText: 'Привет из моего приложения!' }\n}));"
