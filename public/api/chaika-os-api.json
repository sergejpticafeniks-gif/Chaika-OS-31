{
  "openapi": "3.1.0",
  "info": {
    "title": "Чайка ОС API",
    "version": "1.0.0",
    "description": "Официальный программный интерфейс облачной операционной системы Чайка ОС v31. Позволяет сторонним приложениям интегрироваться с ОС: авторизация пользователей, управление окнами, файловая система, мессенджер, уведомления, хранилище, база данных, GPIO, HASP и многое другое.",
    "contact": {
      "name": "Команда Чайка ОС",
      "url": "https://chaika-os.ru",
      "email": "api@chaika-os.ru"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    { "url": "https://api.chaika-os.ru/v1", "description": "Производственный сервер" },
    { "url": "https://sandbox.chaika-os.ru/v1", "description": "Тестовая среда" }
  ],
  "security": [{ "BearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT-токен, полученный через /auth/login или /auth/otp/verify"
      }
    }
  },
  "categories": {
    "auth": "Аутентификация и авторизация",
    "user": "Управление пользователем",
    "desktop": "Рабочий стол и интерфейс",
    "window": "Управление окнами",
    "filesystem": "Файловая система",
    "storage": "Облачное хранилище",
    "messenger": "Мессенджер Чайка",
    "notifications": "Уведомления",
    "database": "База данных",
    "apps": "Приложения и реестр",
    "system": "Система и диагностика",
    "ini": "INI-конфигурации",
    "hardware": "Аппаратные устройства (GPIO/HASP)",
    "ai": "AI-ассистент",
    "crm": "CRM и бизнес-инструменты",
    "media": "Медиа и Тумба",
    "settings": "Настройки ОС",
    "index": "Индексы Я-Россия"
  },
  "functions": [
    {
      "id": "auth.sendOtp",
      "category": "auth",
      "name": "Отправить OTP-код",
      "method": "POST",
      "path": "/auth/otp/send",
      "description": "Отправляет одноразовый пароль на email пользователя для подтверждения регистрации или входа",
      "params": {
        "body": { "email": "string" }
      },
      "returns": { "message": "string", "expires_in": "number" },
      "example": { "email": "user@example.com" }
    },
    {
      "id": "auth.verifyOtp",
      "category": "auth",
      "name": "Подтвердить OTP-код",
      "method": "POST",
      "path": "/auth/otp/verify",
      "description": "Проверяет OTP-код и возвращает сессионный токен",
      "params": {
        "body": { "email": "string", "token": "string" }
      },
      "returns": { "access_token": "string", "refresh_token": "string", "user": "UserObject" }
    },
    {
      "id": "auth.login",
      "category": "auth",
      "name": "Вход по паролю",
      "method": "POST",
      "path": "/auth/login",
      "description": "Авторизация существующего пользователя по email и паролю",
      "params": {
        "body": { "email": "string", "password": "string" }
      },
      "returns": { "access_token": "string", "refresh_token": "string", "user": "UserObject" }
    },
    {
      "id": "auth.register",
      "category": "auth",
      "name": "Регистрация пользователя",
      "method": "POST",
      "path": "/auth/register",
      "description": "Регистрация нового аккаунта в Чайка ОС. После регистрации доступны все приложения экосистемы",
      "params": {
        "body": { "email": "string", "password": "string", "username": "string", "otp_token": "string" }
      },
      "returns": { "access_token": "string", "user": "UserObject" }
    },
    {
      "id": "auth.logout",
      "category": "auth",
      "name": "Выход из системы",
      "method": "POST",
      "path": "/auth/logout",
      "description": "Завершает текущую сессию и инвалидирует токены",
      "returns": { "success": "boolean" }
    },
    {
      "id": "auth.refreshToken",
      "category": "auth",
      "name": "Обновить токен",
      "method": "POST",
      "path": "/auth/refresh",
      "description": "Получает новый access_token по refresh_token",
      "params": {
        "body": { "refresh_token": "string" }
      },
      "returns": { "access_token": "string" }
    },
    {
      "id": "auth.getSession",
